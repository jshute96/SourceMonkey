{
  "name": "sourcemonkey",
  "version": "0.0.1",
  "private": true,
  "description": "Userscript manager Chrome extension that treats userscripts like source code, built and managed with real coding tools",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit",
    "watch": "node scripts/build.mjs --watch",
    "test": "npm run test:unit && npm run test:e2e",
    "pretest:e2e": "node scripts/build.mjs",
    "test:e2e": "playwright test --project=sourcemonkey",
    "pretest:e2e:tm": "node scripts/build.mjs && node scripts/e2e-tm-preflight.mjs --need-closed",
    "test:e2e:tm": "playwright test --project=tampermonkey",
    "pretest:e2e:tm:headed": "node scripts/build.mjs && node scripts/e2e-tm-preflight.mjs --need-open",
    "test:e2e:tm:headed": "TM_HEADED=1 playwright test --project=tampermonkey",
    "test:headed": "playwright test --project=sourcemonkey --headed",
    "pretest:unit": "node scripts/build.mjs",
    "test:unit": "node --test 'tests/unit/*.test.mjs'",
    "prevalidate": "node scripts/build.mjs",
    "validate": "node scripts/validate-userscripts.mjs",
    "clean": "rm -rf dist test-results playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/prismjs": "^1.26.6",
    "prismjs": "^1.30.0",
    "typescript": "^5.6.0"
  }
}
