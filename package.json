{
  "name": "sourcemonkey",
  "version": "0.0.1",
  "private": true,
  "description": "Userscript manager Chrome extension that treats userscripts like source code, built and managed with real coding tools",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "test": "npm run test:unit && npm run test:e2e",
    "pretest:e2e": "node scripts/build.mjs",
    "test:e2e": "playwright test",
    "test:headed": "playwright test --headed",
    "pretest:unit": "node scripts/build.mjs",
    "test:unit": "node --test 'tests/unit/*.test.mjs'",
    "clean": "rm -rf dist test-results playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.0",
    "@types/prismjs": "^1.26.6",
    "prismjs": "^1.30.0",
    "typescript": "^5.6.0"
  }
}
