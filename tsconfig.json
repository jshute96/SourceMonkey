{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"]
  },
  // The extension only. `src/harness/**` is Node-side code Chrome never
  // loads; it is compiled into `lib/` by tsconfig.lib.json, along with
  // the extension modules it imports. See docs/architecture.md.
  "include": ["src/**/*.ts"],
  "exclude": ["src/harness/**"]
}
